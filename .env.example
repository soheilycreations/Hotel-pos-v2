# Supabase project URL and anon (public) key — safe to expose to the browser.
# Find these in your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_,
# never import outside files marked with `import "server-only"`, never commit
# a real value. Used only for privileged admin operations (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this app is served from — used to build the redirect URL for
# invite/password-reset emails (src/server/actions/auth.actions.ts). Must
# also be added to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
